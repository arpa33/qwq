#!/usr/bin/env node

import { Command } from "commander";
import chalk from "chalk";
import ora from "ora";
import { GitHubClient } from "./github.js";
import { analyzeRepository } from "./analyzer.js";
import {
  createJsonReport,
  createMarkdownReport
} from "./report.js";

const program = new Command();

program
  .name("averin")
  .description(
    "Repository intelligence and GitHub project analysis CLI"
  )
  .version("1.0.0");

program
  .command("analyze")
  .description("Analyze a GitHub repository")
  .argument("<repository>", "Repository in owner/name format")
  .option("--json", "Output JSON")
  .option("--markdown", "Output Markdown")
  .option(
    "--token <token>",
    "GitHub personal access token"
  )
  .action(
    async (
      repository: string,
      options: {
        json?: boolean;
        markdown?: boolean;
        token?: string;
      }
    ) => {
      const parts = repository.split("/");

      if (parts.length !== 2) {
        console.error(
          chalk.red(
            "Invalid repository format. Use owner/name."
          )
        );

        process.exitCode = 1;
        return;
      }

      const [owner, repo] = parts;

      const spinner = ora(
        `Analyzing ${repository}...`
      ).start();

      try {
        const client = new GitHubClient(
          options.token ?? process.env.GITHUB_TOKEN
        );

        const data = await client.getRepository(
          owner,
          repo
        );

        const result = analyzeRepository(data);

        spinner.stop();

        if (options.json) {
          console.log(createJsonReport(result));
          return;
        }

        if (options.markdown) {
          console.log(createMarkdownReport(result));
          return;
        }

        console.log();
        console.log(
          chalk.bold(`Repository: ${result.repository.fullName}`)
        );

        console.log(
          `Health Score: ${chalk.bold(
            `${result.healthScore}/100`
          )}`
        );

        console.log(
          `Stars: ${result.repository.stars}`
        );

        console.log(
          `Forks: ${result.repository.forks}`
        );

        console.log(
          `Open Issues: ${result.repository.openIssues}`
        );

        console.log();
        console.log(chalk.bold("Indicators"));

        console.log(
          `  Activity       ${result.indicators.activity}/100`
        );

        console.log(
          `  Maintenance    ${result.indicators.maintenance}/100`
        );

        console.log(
          `  Community      ${result.indicators.community}/100`
        );

        console.log(
          `  Documentation ${result.indicators.documentation}/100`
        );

        console.log();
        console.log(chalk.bold("Recommendations"));

        for (const recommendation of result.recommendations) {
          console.log(`  • ${recommendation}`);
        }

        console.log();
      } catch (error) {
        spinner.fail("Repository analysis failed.");

        const message =
          error instanceof Error
            ? error.message
            : "Unknown error";

        console.error(chalk.red(message));

        process.exitCode = 1;
      }
    }
  );

program.parseAsync(process.argv);

