import type { AnalysisResult, RepositoryStats } from "./types.js";

function clamp(value: number): number {
  return Math.max(0, Math.min(100, Math.round(value)));
}

export function analyzeRepository(
  repository: RepositoryStats
): AnalysisResult {
  const now = Date.now();

  const updatedAt = new Date(repository.updatedAt).getTime();
  const pushedAt = repository.pushedAt
    ? new Date(repository.pushedAt).getTime()
    : updatedAt;

  const daysSinceUpdate =
    (now - updatedAt) / (1000 * 60 * 60 * 24);

  const daysSincePush =
    (now - pushedAt) / (1000 * 60 * 60 * 24);

  const activity = clamp(
    daysSincePush <= 7
      ? 100
      : daysSincePush <= 30
        ? 85
        : daysSincePush <= 90
          ? 65
          : daysSincePush <= 180
            ? 40
            : 15
  );

  const maintenance = clamp(
    daysSinceUpdate <= 30
      ? 100
      : daysSinceUpdate <= 90
        ? 80
        : daysSinceUpdate <= 180
          ? 55
          : 25
  );

  const community = clamp(
    Math.min(
      100,
      Math.log10(repository.stars + 1) * 22 +
        Math.log10(repository.forks + 1) * 18
    )
  );

  let documentation = 30;

  if (repository.description) {
    documentation += 30;
  }

  if (repository.license) {
    documentation += 20;
  }

  if (repository.language) {
    documentation += 20;
  }

  documentation = clamp(documentation);

  const healthScore = clamp(
    activity * 0.30 +
      maintenance * 0.30 +
      community * 0.20 +
      documentation * 0.20 -
      (repository.archived ? 30 : 0)
  );

  const recommendations: string[] = [];

  if (activity < 60) {
    recommendations.push(
      "Increase development activity and maintain a consistent commit cadence."
    );
  }

  if (maintenance < 60) {
    recommendations.push(
      "Review stale issues, dependencies, and repository maintenance workflows."
    );
  }

  if (documentation < 60) {
    recommendations.push(
      "Improve repository metadata, documentation, and licensing information."
    );
  }

  if (community < 50) {
    recommendations.push(
      "Improve discoverability and contribution workflows for the community."
    );
  }

  if (repository.archived) {
    recommendations.push(
      "Repository is archived and should not be treated as actively maintained."
    );
  }

  if (recommendations.length === 0) {
    recommendations.push(
      "Repository indicators are healthy. Continue monitoring activity and maintenance."
    );
  }

  return {
    repository,
    healthScore,
    indicators: {
      activity,
      maintenance,
      community,
      documentation
    },
    recommendations
  };
}

